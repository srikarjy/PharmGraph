# Pharmacogenomics ML Platform - Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application Settings
APP_NAME=pharmacogenomics-platform
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-here-change-this-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
DATABASE_URL=postgresql://pgx_user:pgx_password@localhost:5432/pharmacogenomics
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# Celery Configuration (Background Tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json

# NCBI API Configuration
NCBI_API_KEY=your-ncbi-api-key-here
NCBI_EMAIL=your-email@institution.edu
NCBI_TOOL=pharmacogenomics-platform
NCBI_RATE_LIMIT=10
NCBI_TIMEOUT=30

# ML Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_CACHE_SIZE=5
MODEL_BATCH_SIZE=32
MODEL_TIMEOUT=60
ENABLE_GPU=false

# Authentication & Security
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# External Services
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
ELASTICSEARCH_URL=http://localhost:9200
PROMETHEUS_GATEWAY=http://localhost:9091

# File Storage
UPLOAD_DIR=./data/uploads
MODEL_DIR=./models
CACHE_DIR=./cache
LOG_DIR=./logs

# Monitoring & Observability
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_TRACING=false
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# Feature Flags
ENABLE_ASYNC_PROCESSING=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_AUTHENTICATION=true

# Development Settings (only for development)
RELOAD=true
PROFILING=false
MOCK_EXTERNAL_APIS=false