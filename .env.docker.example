# Docker Environment Configuration
# Use this for Docker Compose deployments

# Application Settings
APP_NAME=pharmacogenomics-platform
APP_ENV=docker
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=docker-secret-key-change-in-production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database Configuration (Docker service names)
DATABASE_URL=postgresql://pgx_user:pgx_password@postgres:5432/pharmacogenomics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# Redis Configuration (Docker service name)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

# NCBI API Configuration
NCBI_API_KEY=your-ncbi-api-key-here
NCBI_EMAIL=your-email@institution.edu
NCBI_TOOL=pharmacogenomics-platform

# ML Configuration
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_CACHE_SIZE=10

# External Services (Docker service names)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ELASTICSEARCH_URL=http://elasticsearch:9200

# Container-specific settings
WAIT_FOR_SERVICES=postgres:5432 redis:6379
RUN_MIGRATIONS=true
INIT_APP=true