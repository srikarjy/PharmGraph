# Kubernetes Environment Configuration
# Use this as reference for Kubernetes ConfigMaps and Secrets

# Application Settings
APP_NAME=pharmacogenomics-platform
APP_ENV=kubernetes
DEBUG=false
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=8

# Database Configuration (Kubernetes service names)
DATABASE_URL=postgresql://pgx_user:$(DATABASE_PASSWORD)@postgres-service:5432/pharmacogenomics
DATABASE_POOL_SIZE=50
DATABASE_MAX_OVERFLOW=100

# Redis Configuration (Kubernetes service name)
REDIS_URL=redis://redis-service:6379/0
CELERY_BROKER_URL=redis://redis-service:6379/1
CELERY_RESULT_BACKEND=redis://redis-service:6379/1

# NCBI API Configuration (from Kubernetes secrets)
NCBI_API_KEY=$(NCBI_API_KEY_SECRET)
NCBI_EMAIL=$(NCBI_EMAIL_SECRET)
NCBI_TOOL=pharmacogenomics-platform

# ML Configuration
MLFLOW_TRACKING_URI=http://mlflow-service:5000
MODEL_CACHE_SIZE=20

# External Services (Kubernetes service names)
KAFKA_BOOTSTRAP_SERVERS=kafka-service:9092
ELASTICSEARCH_URL=http://elasticsearch-service:9200

# Kubernetes-specific settings
ENABLE_METRICS=true
METRICS_PORT=9090
ENABLE_HEALTH_CHECKS=true
GRACEFUL_SHUTDOWN_TIMEOUT=30